{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-US",
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "HexValues",
    "markdownCodeBlock",
    "markdownInlineCode",
    "modelIdentifiers"
  ],
  "patterns": [
    {
      "name": "markdownCodeBlock",
      "pattern": "/^```[\\s\\S]*?^```/gm"
    },
    {
      "name": "markdownInlineCode",
      "pattern": "/`[^`\\n]+`/g"
    },
    {
      "name": "modelIdentifiers",
      "pattern": "/\\b[a-zA-Z]+-[0-9]+[a-zA-Z0-9.-]*\\b/g"
    }
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".cspell/project-words.txt",
      "addWords": true
    },
    {
      "name": "ai-terms",
      "path": "./.cspell/ai-terms.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "ai-terms",
    "bash",
    "companies",
    "cpp",
    "data-science-models",
    "data-science-tools",
    "data-science",
    "git",
    "project-words",
    "softwareTerms"
  ],
  "ignorePaths": [
    ".git",
    "node_modules",
    "LICENSE",
    ".gitignore",
    "project-words.txt"
  ]
}
